# Rosetta enzyme-design flags, shared by the docking and design stages.
# Copy to your run directory and replace the two placeholders at the bottom.

-run:preserve_header
-run:version
-nblist_autoupdate
-linmem_ig 10
-jd2::enzdes_out

# Metalloenzymes: let Rosetta set up metal-coordination constraints itself.
-in:auto_setup_metals
-in::ignore_unrecognized_res

-enzdes::minimize_all_ligand_torsions 5.0
-enzdes::detect_design_interface
-enzdes::favor_native_res 2
-enzdes::bb_min_allowed_dev 0.05

-ligand::old_estat
-packing::extrachi_cutoff 1
-packing::ex1
-packing::ex2
-packing::ex1aro:level 6
-packing::use_input_sc
-packing::flip_HNQ
-packing::no_optH false
-packing::optH_MCA false

-chemical:exclude_patches LowerDNA UpperDNA Cterm_amidation VirtualBB ShoveBB VirtualDNAPhosphate CTermConnect sc_orbitals pro_hydroxylated_case1 pro_hydroxylated_case2 ser_phosphorylated thr_phosphorylated tyr_phosphorylated tyr_sulfated lys_dimethylated lys_monomethylated lys_trimethylated lys_acetylated glu_carboxylated cys_acetylated tyr_diiodinated N_acetylated C_methylamidated MethylatedProteinCterm

# --- edit these two -------------------------------------------------------
-enzdes::cstfile CST_FILE_HERE
-extra_res_fa LIGAND_PARAMS_HERE
